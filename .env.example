# =========================================================
#  Plantilla de configuración de SivIA
#  Copiar a .env y rellenar con valores reales:
#      cp .env.example .env
#  El archivo .env NUNCA se sube a Git (ver .gitignore).
# =========================================================
PROJECT_NAME="SivIA - Sistema de Inventario por Voz con IA"
ENVIRONMENT=production

# ---- Base de Datos MySQL ----
# Generar contraseñas aleatorias, por ejemplo con:
#   python3 -c "import secrets,string; a=string.ascii_letters+string.digits; print(''.join(secrets.choice(a) for _ in range(32)))"
MYSQL_ROOT_PASSWORD=cambiar_por_password_aleatorio_de_32_caracteres
MYSQL_DATABASE=sivia_db
MYSQL_USER=sivia_user
MYSQL_PASSWORD=cambiar_por_password_aleatorio_de_32_caracteres

# ---- Motor de IA (Ollama nativo en la Raspberry Pi 5) ----
# 172.17.0.1 es la IP del bridge de Docker hacia el host.
OLLAMA_HOST=http://172.17.0.1:11434
MODEL_NAME=qwen2.5:3b
OLLAMA_TIMEOUT=60

# Modelo del chat conversacional. Si se omite, se usa MODEL_NAME, y conviene
# dejarlo así: dos modelos distintos quedan AMBOS residentes en RAM. Medido en
# el Pi 5, qwen2.5:3b (2,4 GB) + qwen2.5:7b (5,1 GB) dejaron el sistema en
# 194 MB libres, al borde del OOM killer.
# MODEL_CHAT=qwen2.5:3b

# Timeout propio del chat, más holgado que el de la extracción: un turno genera
# la respuesta en lenguaje natural además del JSON, y tarda 15-30 s.
OLLAMA_TIMEOUT_CHAT=180

# ---- Conversación ----
# Turnos previos que se envían al modelo como contexto. Subirlo alarga la
# inferencia; 8 basta para entender un "¿y de las otras?".
MAX_MENSAJES_CONTEXTO=8

# Cuánto vive una acción propuesta y no confirmada. Pasado ese tiempo no se
# ejecuta: confirmar mañana un "vendimos 20 arepas" de hoy lo registraría con
# la fecha de mañana.
VIGENCIA_ACCION_MINUTOS=30

# ---- Seguridad de la API ----
# Clave del header X-API-Key. Es la credencial de MÁQUINA (scripts, curl) y
# equivale a un administrador. Las personas no la usan: entran con su cuenta.
# También es con la que se crea el primer usuario (ver README).
#   python3 -c "import secrets; print(secrets.token_urlsafe(36))"
SIVIA_API_KEY=cambiar_por_una_clave_aleatoria_larga

# Duración de una sesión de usuario. 12 h cubre una jornada sin obligar a
# volver a entrar a media mañana, y deja fuera el móvil olvidado toda la noche.
DURACION_SESION_HORAS=12

# Orígenes permitidos por CORS (separados por coma) para la app móvil / web.
# Usar "*" solo en desarrollo; en producción listar los orígenes concretos.
CORS_ORIGINS=*
